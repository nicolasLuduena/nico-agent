  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "The form's one action: the accent's fill.",
      "html": "<button class=\"ds-button\">Dispatch</button>",
      "css": ".ds-button{min-height:36px;padding:0 16px;border:1px solid var(--accent);border-radius:var(--radius-control);background:var(--accent);color:var(--accent-ink);font:600 14px/1.45 ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-button:hover{background:color-mix(in srgb,var(--accent) 86%,var(--ink))}.ds-button:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Quiet button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Every other action: surface, a rule frame.",
      "html": "<button class=\"ds-quiet\">Refresh</button>",
      "css": ".ds-quiet{min-height:36px;padding:0 14px;border:1px solid var(--rule);border-radius:var(--radius-control);background:var(--surface);color:var(--ink);font:600 14px/1.45 ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-quiet:hover{background:var(--raised)}.ds-quiet:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "A field under its sentence-case label.",
      "html": "<label class=\"ds-field\"><span>Base</span><input value=\"main\"></label>",
      "css": ".ds-field{display:grid;gap:4px;font:400 14px/1.45 ui-sans-serif,system-ui,sans-serif}.ds-field span{color:var(--ink-muted)}.ds-field input{min-height:36px;padding:0 10px;border:1px solid var(--rule);border-radius:var(--radius-control);background:var(--surface);color:var(--ink);font:inherit}.ds-field input:hover{border-color:var(--ink)}.ds-field input:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Needs you badge",
      "kind": "chip",
      "refersTo": "needs",
      "description": "Needs you, on its issue or at the notices band's head; the only amber.",
      "html": "<span class=\"ds-needs\">Needs you</span>",
      "css": ".ds-needs{display:inline-flex;align-items:center;padding:0 8px;min-height:20px;border:1px solid var(--signal-edge);border-radius:999px;background:var(--signal);color:var(--signal-ink);font:600 12px/18px ui-sans-serif,system-ui,sans-serif;white-space:nowrap}"
    },
    {
      "name": "Node",
      "kind": "card",
      "refersTo": "node",
      "description": "A map node: its title first, then number and Repo, then its Stage in words beside its mark.",
      "html": "<button class=\"ds-node\"><span class=\"t\">Verify: a Ready issue</span><span class=\"r\">#1 <span>· fixture</span></span><span class=\"s\"><svg width='14' height='14' viewBox='0 0 14 14' aria-hidden='true'><circle cx='7' cy='7' r='5.25' fill='none' stroke='currentColor' stroke-width='1.5'/></svg>Ready</span></button>",
      "css": ".ds-node{display:grid;row-gap:4px;width:248px;min-height:108px;align-content:start;padding:8px 12px;text-align:left;background:var(--surface);color:var(--ink);border:1px solid var(--hairline);border-radius:var(--radius);box-shadow:var(--shadow);font:400 13px/18px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-node:hover{border-color:var(--rule)}.ds-node:focus-visible{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),var(--shadow);outline:none}.ds-node .t{font:600 15px/20px ui-sans-serif,system-ui,sans-serif}.ds-node .r span{color:var(--ink-muted)}.ds-node .s{display:inline-flex;gap:6px;align-items:center;color:var(--ready);font-weight:600}"
    },
    {
      "name": "Notice",
      "kind": "custom",
      "refersTo": "notice",
      "description": "One row of the notices band: a white card in a hairline, no coloured edge, a drawn × to dismiss.",
      "html": "<div class=\"ds-notice\"><strong>Check</strong><span>verify/fixture</span><span class=\"m\">5 checks fail · Readiness, under Repos</span><span class=\"e\"><button class=\"more\">Show the checks</button><button class=\"x\" aria-label=\"Dismiss\"><svg viewBox='0 0 14 14' width='14' height='14' aria-hidden='true'><path d='M3 3 L11 11 M11 3 L3 11'/></svg></button></span></div>",
      "css": ".ds-notice{display:flex;flex-wrap:wrap;align-items:center;gap:0 8px;min-height:42px;padding:4px 4px 4px 12px;background:var(--surface);color:var(--ink);border:1px solid var(--hairline);border-radius:var(--radius);box-shadow:var(--shadow);font:400 14px/1.45 ui-sans-serif,system-ui,sans-serif}.ds-notice .m{color:var(--ink-muted);font-size:13px}.ds-notice .e{display:flex;gap:4px;align-items:center;margin-left:auto}.ds-notice .more{min-height:28px;padding:0 10px;border:1px solid var(--rule);border-radius:var(--radius-control);background:var(--surface);color:var(--ink);font:600 13px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-notice .more:hover,.ds-notice .x:hover{background:var(--raised)}.ds-notice .x{display:grid;place-items:center;min-width:32px;min-height:32px;border:0;border-radius:var(--radius-control);background:none;color:var(--ink-muted);cursor:pointer}.ds-notice .x path{fill:none;stroke:currentColor;stroke-width:1.5}.ds-notice button:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Errata",
      "kind": "custom",
      "description": "A refusal or failure: a 1px failed frame on a faint failed wash, Failed's drawn cross before it.",
      "html": "<p class=\"ds-errata\"><strong>gh: not found</strong></p>",
      "css": ".ds-errata{position:relative;margin:0;padding:8px 12px 8px 32px;border:1px solid var(--failed);border-radius:var(--radius-control);background:color-mix(in srgb,var(--failed) 6%,var(--surface));color:var(--ink);font:400 14px/1.45 ui-sans-serif,system-ui,sans-serif}.ds-errata::before{content:'';position:absolute;top:12px;left:12px;width:12px;height:12px;background:var(--failed);mask:url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 14 14'><path d='M2 2 L12 12 M12 2 L2 12' stroke='black' stroke-width='2.25'/></svg>\") center/contain no-repeat}"
    },
    {
      "name": "Zoom group",
      "kind": "custom",
      "description": "The map's tools bar, right: joined quiet buttons, drawn − and +, the scale as text between them.",
      "html": "<div class=\"ds-zoom\"><button aria-label=\"Zoom out\"><svg width='14' height='14' viewBox='0 0 14 14'><path d='M2.5 7 H11.5'/></svg></button><span>100%</span><button aria-label=\"Zoom in\"><svg width='14' height='14' viewBox='0 0 14 14'><path d='M2.5 7 H11.5 M7 2.5 V11.5'/></svg></button><button>Fit</button></div>",
      "css": ".ds-zoom{display:inline-flex;font:600 14px/1.45 ui-sans-serif,system-ui,sans-serif}.ds-zoom>*+*{margin-left:-1px}.ds-zoom button{display:inline-flex;align-items:center;justify-content:center;min-width:36px;min-height:36px;padding:0 10px;border:1px solid var(--rule);background:var(--surface);color:var(--ink);font:inherit;cursor:pointer}.ds-zoom button:hover{background:var(--raised)}.ds-zoom button:focus-visible{position:relative;outline:2px solid var(--focus);outline-offset:2px}.ds-zoom button:first-child{border-radius:var(--radius-control) 0 0 var(--radius-control)}.ds-zoom button:last-child{border-radius:0 var(--radius-control) var(--radius-control) 0}.ds-zoom path{fill:none;stroke:currentColor;stroke-width:1.5}.ds-zoom span{display:inline-flex;align-items:center;justify-content:center;min-width:52px;border-block:1px solid var(--rule);background:var(--surface);color:var(--ink-muted);font:400 13px ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums}"
    }
  ],
  "narrative": {
    "northStar": "A calm work map",
    "overview": "The page is one workspace, read at the desk in the morning and checked on the phone. It answers two questions at a glance: what work is happening, and what needs me. The Project's map is the centre of it; everything else is either how you got there (the Projects rail, the views) or what you do with what you picked (the inspector). Settings exist and are one click away, but they never sit beside the work while you only watch it.\n\nLight is the everyday workspace: a neutral grey page, white cards and panels with hairline frames, readable system type. Dark is the same layout and the same components on a near-black page for a focused evening: no new layout, no new components, only its own tokens. Themes are Light, Dark and System. System follows `prefers-color-scheme` and is the default; the choice is remembered in `localStorage`.\n\nMotion is short and functional. The inspector slides in 160ms ease-out (rises, on a phone). When a refetch changes a node's Stage, its Stage row flashes once (200ms), as does a notice new to the page (not on the first read) and the read times when a read moves them (not when another Project shows its own). When a node taking keyboard focus, an opened node or Fit moves the map, its field scrolls there smoothly (the browser's own smooth scroll); a drag or a zoom takes over where it is. Nothing loops and nothing moves on load. Under `prefers-reduced-motion` all motion is off and changes simply appear.",
    "keyCharacteristics": [],
    "rules": [
      {
        "name": "The Words First Rule",
        "body": "Every state is said in words: a Stage is its word, an agent's state is `Asking`, `Working` or `Idle`, needs you is `Needs you`. Colour and icons repeat what the word says, so the page reads without colour and without a legend of shapes to learn.",
        "section": "overview"
      },
      {
        "name": "The One Accent Rule",
        "body": "One accent marks what is selected and what you can act on: the open node, the current Project, the current view, links, focus and the form's one action. No other hue is used for selection.",
        "section": "overview"
      },
      {
        "name": "The Phone Field Exception",
        "body": "Under 720px, the text inside a field (`field-phone`) is 16px, so iOS never zooms the page into it.",
        "section": "typography"
      },
      {
        "name": "The Right Column Rule",
        "body": "Every time on the page (Source read, PRs checked, restarted at, Verdict at, paused until) is `HH:MM`, plus the date when it isn't today, and sits at the right where it is in a row.",
        "section": "typography"
      },
      {
        "name": "The No Scroll Rule",
        "body": "At 360px wide, nothing is wider than the viewport. Long titles wrap to two lines on nodes and wrap whole in the inspector.",
        "section": "layout"
      },
      {
        "name": "The No Side Edge Rule",
        "body": "No card, notice, row, rail item or errata carries a coloured edge down one side. State is a frame (a hairline, the accent's doubled frame, the errata's `failed` hairline), a fill (`accent-soft`, the errata's wash), a word, and a drawn mark.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** say every state in words, and let colour and icons repeat it.",
      "**Do** keep the accent for selection and action, amber for needs you, and each Stage hue for its Stage; a token here and in `app.css`, never a hex in a component.",
      "**Do** put the next useful action first in the inspector, and the secondary detail in a labelled disclosure.",
      "**Do** keep settings behind `Repos`, and fold what is set once and left, saying what is set on the folded line.",
      "**Do** say a save happened beside the field; never grey a field out while it saves.",
      "**Do** put needs you without a node in the notices band under the view tabs, in the flow, and the map's tools in the bar under it; nothing floats over the map."
    ],
    "donts": [
      "**Don't** add counters, progress summaries, KPI tiles or a global dashboard; needs you stays on its issue, or in a notice when it has none.",
      "**Don't** show an action the app does not support (an Open agent button, a merge button), or a state it does not know (a \"Loop running\" light).",
      "**Don't** colour Repos, tint cards with their Stage, or ask the reader to learn a legend of shapes.",
      "**Don't** add mascots, bounce or confetti, and no monospace beyond the Asking pane and commands.",
      "**Don't** put a coloured edge down one side of a card, a notice, a row or the rail's current Project (the No Side Edge Rule).",
      "**Don't** pad toward airiness: six nodes in two chains read at 100% at 1440×900, under the header, the notices band and the tabs, without scrolling the page."
    ]
  }
}
