#!/usr/bin/env bash
# control-nico-agent: drive nico-agent (its CLI and serve's page) in a scratch HOME.
#
# Every subcommand works inside one run directory, chosen by VERIFY_RUN_ID (normally the issue number):
#   $VERIFY_RUN_ROOT/$VERIFY_RUN_ID   (VERIFY_RUN_ROOT defaults to ${TMPDIR:-/tmp}/verify-nico-agent)
# The run has its own HOME (so its own ~/.config/nico-agent), two fixture clones, a Bucket,
# a free port for serve, and stubs for gh, ghbot, herdr, notify-send, curl and opencode2 first on PATH.
# Needs cargo, git, jq, curl, node, ss, setsid; `page` needs the playwright CLI on PATH (and its
# browser, or a chromium on PATH). Run from the repo root.
#
# Subcommands:
#   launch [--no-build]           build, make the scratch HOME, fixtures and config, start serve; prints
#                                 serve's pid and URL once /api/status answers. Refuses to run twice for one
#                                 VERIFY_RUN_ID (cleanup first). --no-build reuses target/debug/nico-agent.
#   restart                       stop this run's serve and start it again on the same HOME and port, as a reboot would
#   doctor                        read-only: is this run worth driving? A failing doctor means "do not drive"
#   env                           print the path of run.env, to source: . "$(control-nico-agent env)"
#                                 gives $FIXTURE_CLONE, $SECOND_CLONE, $CONFIG_DIR, $BUCKET, $URL, $OUTSIDE_LOG
#   seed issues [second]          a fresh Source read of verify/fixture (issues 1-6), or verify/second (1-3)
#   seed dispatch <n> pr|asking|stacked|restarted
#                                 a Dispatch of verify/fixture#<n> as the loop records it; prints
#                                 { issue, kind, worktree, branch, head, pr, evidence }: keep it, verdict recipes need head
#   seed run quality-scan|morning|faux-nico <n>
#                                 a Run of the loop's own agent, blocked, as the loop records it; prints JSON
#   seed morning <file>|none      the Morning summary the morning agent leaves: <file> as morning.md, or none
#   seed answer <file>|none [<part>]  what the wiki model answers every headless call: <file>'s text, or none
#                                 (then each call fails as opencode2 does with no model); with <part>, a trail
#                                 such as `verify/fixture > Docs`, only the calls asking about that part
#   seed correction <file>|none   what the wiki model answers each correction (a call with -s): <file>'s text,
#                                 or none (then the answer for its part)
#   seed pace <seconds>|none      how long the wiki model takes over each call before it answers, or none
#   seed assign answers|none      whether GitHub answers an assign to the user (gh issue edit --add-assignee @me),
#                                 as once signed in; none, it fails as gh with no login does
#   seed herdr <agent>|none       the real herdr's list of agents, and what is asked of <agent> there, reach
#                                 the real herdr; with none, herdr is all a stub again
#   seed dialog <n>|none          a real Claude in a herdr tab of its own, impl-fixture-<n>, Asking two questions
#                                 in a choice dialog, reached through seed herdr; none closes it. Needs herdr and claude
#   seed reviewer <n>|none        herdr answers the start of rev-fixture-<n>, a Reviewer of a Dispatch seeded `pr`,
#                                 as it would, and lists it working beside its idle Implementer; none, a stub again.
#                                 Not with seed herdr
#   seed wiki <wiki.json> <clone> a Repo's Wiki built elsewhere committed to the Bucket, and that Repo cloned
#                                 on disk from <clone> for `repo add`; prints { repo, clone, commit }
#   drift push <n>|stale|pause|below merged|closed|base [<file>]|tag <tag>
#                                 what GitHub would change: a new PR head, an old read, a rate limit,
#                                 the PR below a Stacked dispatch merged or closed unmerged,
#                                 verify/fixture's Base moved on (and fetched), verify/second tagged
#   state                         read-only fingerprint: config dir files, Dispatches, Verdicts, Bucket log, outside calls
#   run [--evidence PREFIX] -- <nico-agent args...>
#                                 run the CLI in the scratch HOME (cwd: the run's work/, so pass absolute paths);
#                                 exit code is the CLI's
#   http [--evidence PREFIX] [--header 'NAME: VALUE']... <METHOD> <PATH> [BODY]
#                                 ask this run's serve, as the page does; exit 1 on 4xx/5xx
#   page [--tunnel] [--evidence PREFIX] [--width PX] [--scheme light|dark] [--storage FILE|none] [--path PATH] [--hash HASH] [--within ROLE=NAME|page | --click ROLE=NAME | --click ROLE~NAME | --press KEY
#        | --type TEXT | --expect TEXT | --gone TEXT | --wait SECONDS | --history back|forward | --mode pass|502|signed-out | --hold SECONDS]...
#                                 open serve's page in headless Chromium, act in order, capture; prints ok or
#                                 FAIL per step and exits 1 on the first failure, after capturing
#   tunnel start|pass|502|signed-out
#                                 a stand-in for cloudflared and Access in front of serve ($TUNNEL_URL, $TUNNEL_LOG)
#   cleanup                       stop everything this run started, remove the run dir (never .evidence/)
#
# --evidence PREFIX writes: run: PREFIX.cmd, .stdout, .stderr, .exit; http: .cmd (each --header in brackets
# first), .stdout (the body), .stderr, .exit (the HTTP status), .headers; page: .cmd, .aria.txt, .png (the whole
# page), .view.png (the window, as scrolled), .view.txt (address, scroll, page width against the window's, focus),
# .requests.txt (each /api call, and each /api/events stream as answered: a reconnect is a line), .console.txt.
# Each still prints what it captured.
#
# page steps: --click tab=verify/second clicks the element of that ARIA role whose accessible name is exactly
# the text; --click "button~Failed verify/fixture #1" one whose name contains it; --within "region=verify/fixture"
# makes every later --click look only inside that element, --within page the whole page again; --press ArrowRight
# a key; --type dev text into what has focus; --expect TEXT waits for the text; --gone TEXT up to a minute for it
# to go; --wait 120 lets two minutes pass; --history back|forward the browser's buttons; --mode 502 switches the
# tunnel stand-in (with --tunnel only); --hold 20 holds each later write to /api (PATCH, POST, DELETE) 20 seconds
# on its way to serve, no step waiting for it (a write still held when the page closes never reaches serve);
# --path /wiki/verify/fixture opens a Wiki's page instead of the Board, --hash "#readme" that fragment; --scheme
# dark a browser whose system colours are dark. Each page is a new browser with nothing stored: --storage FILE
# starts it with the storage FILE holds (none the first time) and saves it back, so the next page with the same
# FILE is a reload in the same browser; --storage none a browser whose localStorage throws.
#
# tunnel start sets bucket.url to the stand-in's URL (serve refuses a host not its own) and puts tunnel.mjs between
# the page and serve, where cloudflared and Access sit: it cuts a response that sends nothing for 100 seconds, as
# Cloudflare does; 502 answers every request with a 502 and cuts the open streams, as a dropped tunnel does;
# signed-out answers Access's redirect to its login on another origin and leaves streams open, as a lapse does;
# pass passes requests on again. Each answer and each stream's end is logged to $TUNNEL_LOG.
set -euo pipefail

SKILL_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SKILL_DIR/../../.." && pwd)"
RUN_ROOT="${VERIFY_RUN_ROOT:-${TMPDIR:-/tmp}/verify-nico-agent}"
REAL_HOME="$HOME"
SLUG=verify/fixture
SECOND=verify/second

die() { printf 'control-nico-agent: %s\n' "$*" >&2; exit 1; }

require_run_id() {
  [ -n "${VERIFY_RUN_ID:-}" ] || die "VERIFY_RUN_ID is unset. Pick one per verification run, e.g. export VERIFY_RUN_ID=<issue>"
  case "$VERIFY_RUN_ID" in
    */*|.|..|"") die "VERIFY_RUN_ID must be a plain name, got '$VERIFY_RUN_ID'" ;;
  esac
  RUN_DIR="$RUN_ROOT/$VERIFY_RUN_ID"
  FIXTURE_HOME="$RUN_DIR/home"
  CONFIG_DIR="$FIXTURE_HOME/.config/nico-agent"
  RUN_ENV="$RUN_DIR/run.env"
}

load_run() {
  require_run_id
  [ -f "$RUN_ENV" ] || die "no run at $RUN_DIR (missing run.env). Run: control-nico-agent launch"
  # shellcheck disable=SC1090
  . "$RUN_ENV"
}

# nico-agent, git and anything else that must see the scratch HOME run through this: a clean
# environment (no GH_TOKEN, GIT_*, DBUS or XDG_RUNTIME_DIR of the real session), HOME and every
# XDG dir in the run, the system git config ignored, the stubs first on PATH.
in_fixture() {
  local cwd="$1"; shift
  (cd "$cwd" && exec env -i \
    PATH="$RUN_DIR/stubs:$PATH" \
    HOME="$FIXTURE_HOME" \
    USER="${USER:-verify}" \
    LANG=C.UTF-8 \
    TMPDIR="$RUN_DIR/tmp" \
    XDG_CONFIG_HOME="$FIXTURE_HOME/.config" \
    XDG_CACHE_HOME="$FIXTURE_HOME/.cache" \
    XDG_DATA_HOME="$FIXTURE_HOME/.local/share" \
    XDG_STATE_HOME="$FIXTURE_HOME/.local/state" \
    XDG_RUNTIME_DIR="$RUN_DIR/runtime" \
    GIT_CONFIG_NOSYSTEM=1 \
    "$@")
}

fgit() { # fgit <cwd> <git args...>
  local cwd="$1"; shift
  in_fixture "$cwd" git "$@"
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

cargo_version() { sed -n 's/^version = "\(.*\)"$/\1/p' "$REPO_ROOT/Cargo.toml" | head -1; }

free_port() {
  node -e 'const s=require("net").createServer();s.listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})'
}

# Where the playwright package is: beside the `playwright` CLI on PATH, as npm (and mise) install it.
playwright_dir() {
  if [ -n "${VERIFY_PLAYWRIGHT:-}" ]; then echo "$VERIFY_PLAYWRIGHT"; return 0; fi
  local bin; bin="$(command -v playwright)" || return 1
  local dir; dir="$(dirname -- "$(readlink -f -- "$bin")")/../playwright"
  [ -f "$dir/package.json" ] && (cd "$dir" && pwd -P)
}

write_stubs() {
  local stubs="$RUN_DIR/stubs" log="$RUN_DIR/outside.log"
  local real_herdr; real_herdr="$(printf '%q' "$(command -v herdr || echo herdr-is-not-installed)")"
  # The real herdr's socket, which herdr would look for under the scratch HOME.
  local real_socket; real_socket="$(printf '%q' "${HERDR_SOCKET_PATH:-$REAL_HOME/.config/herdr/herdr.sock}")"
  mkdir -p "$stubs"
  : > "$log"
  cat > "$stubs/outside-stub" <<EOF
#!/usr/bin/env bash
# verify-nico-agent stub: records the call in $log and reaches nothing.
name="\$(basename "\$0")"
# One write per line: serve and a CLI run may call stubs at the same moment.
line="\$name\$(printf ' %q' "\$@")"
# opencode2 takes its config inline: the line shows what it was allowed.
[ -z "\${OPENCODE_CONFIG_CONTENT:-}" ] || line="OPENCODE_CONFIG_CONTENT=\$(printf '%q' "\$OPENCODE_CONFIG_CONTENT") \$line"
printf '%s\\n' "\$line" >> "$log"
case "\$name" in
  # Seeded to answer: an assign to the user, as GitHub would take it.
  gh) if [ -f "$RUN_DIR/gh-assign" ] && [ "\$1 \$2" = "issue edit" ] && [ "\${*: -2}" = "--add-assignee @me" ]; then exit 0; fi
    echo "To get started with GitHub CLI, please run:  gh auth login" >&2; exit 4 ;;
  # What the real gh says in a HOME that never ran \`gh auth login\`.
  ghbot) echo "To get started with GitHub CLI, please run:  gh auth login" >&2; exit 4 ;;
  # \`seed herdr <agent>\`: the list of agents, and what is asked of that one agent, reach the real herdr.
  herdr)
    agent="\$(cat "$RUN_DIR/herdr-agent" 2>/dev/null || true)"
    if [ -n "\$agent" ] && [ "\${1:-}" = agent ] \
      && { [ "\${2:-}" = list ] || { [ "\${3:-}" = "\$agent" ] && [[ "\${2:-}" =~ ^(read|send-keys|prompt|wait)\$ ]]; }; }; then
      HERDR_SOCKET_PATH=$real_socket exec $real_herdr "\$@"
    fi
    # \`seed reviewer <n>\`: herdr starts rev-fixture-<n> as it would, in a tab of its own, and lists it
    # working once started, beside its Dispatch's Implementer, idle, which is never restarted for it.
    n="\$(cat "$RUN_DIR/herdr-reviewer" 2>/dev/null || true)"
    if [ -n "\$n" ]; then
      rev="rev-fixture-\$n"
      case "\${1:-} \${2:-}" in
        "tab create") if [[ " \$* " == *" --label reviewer "* ]]; then
            echo '{"result":{"tab":{"tab_id":"verify:t-rev"},"root_pane":{"pane_id":"verify:p-rev"}}}'; exit 0
          fi ;;
        "tab close") if [ "\${3:-}" = verify:t-rev ]; then rm -f "$RUN_DIR/herdr-reviewer-started"; exit 0; fi ;;
        "agent start") if [ "\${3:-}" = "\$rev" ]; then : > "$RUN_DIR/herdr-reviewer-started"; echo '{"result":{}}'; exit 0; fi ;;
        "agent prompt") if [ "\${3:-}" = "\$rev" ]; then echo '{"result":{}}'; exit 0; fi ;;
        "agent list")
          started="\$([ -f "$RUN_DIR/herdr-reviewer-started" ] && echo true || echo false)"
          jq -cn --arg n "\$n" --argjson started "\$started" '{result: {agents: ([{name: "impl-fixture-\(\$n)", agent_status: "idle"}]
            + if \$started then [{name: "rev-fixture-\(\$n)", agent_status: "working"}] else [] end)}}'
          exit 0 ;;
      esac
    fi
    echo '{"error":{"code":"verify_stub","message":"herdr is a stub in this verification run"}}' >&2; exit 1 ;;
  # Recorded, never shown on the desktop.
  notify-send) exit 0 ;;
  curl) echo "curl: (6) verify-nico-agent: no network in this run" >&2; exit 6 ;;
  # \`run --format json\`'s events: the seeded answer as its last message, in its session, else
  # its error. The answer seeded for the part the prompt asks about, else the one for every part.
  # A call with \`-s\` continues that session, answered by the seeded correction if any.
  opencode2)
    session="" prev=""
    for arg in "\$@"; do [ "\$prev" != "-s" ] || session="\$arg"; prev="\$arg"; done
    part="\$(printf '%s' "\${@: -1}" | sed -n 's/^## \\(The part\\|Corrections to the part\\): //p' | head -n 1)"
    answer="$RUN_DIR/opencode-answers/\$(printf '%s' "\$part" | md5sum | cut -c 1-32)"
    [ -f "\$answer" ] || answer="$RUN_DIR/opencode-answer"
    [ -z "\$session" ] || [ ! -f "$RUN_DIR/opencode-correction" ] || answer="$RUN_DIR/opencode-correction"
    [ -n "\$session" ] || session="ses_verify_\$(wc -l < "$log")"
    [ ! -f "$RUN_DIR/opencode-pace" ] || sleep "\$(cat "$RUN_DIR/opencode-pace")"
    if [ -f "\$answer" ]; then
      jq -cn --rawfile text "\$answer" --arg session "\$session" '{type: "text", sessionID: \$session, part: {type: "text", text: \$text}}'
      exit 0
    fi
    echo '{"type":"error","error":{"type":"provider.no-route","message":"Model unavailable: opencode2 is a stub in this verification run"}}'
    exit 1 ;;
esac
EOF
  chmod +x "$stubs/outside-stub"
  local name
  for name in gh ghbot herdr notify-send curl opencode2; do ln -s outside-stub "$stubs/$name"; done
}

# A clone of <slug> whose origin is https://github.com/<slug>.git, which the scratch HOME's
# git config rewrites to a bare repo in the run dir: `repo add` sees a GitHub clone, `fetch` stays local.
make_clone() {
  local slug="$1" name="${1#*/}"
  local seed="$RUN_DIR/fixture/$name-seed" bare="$RUN_DIR/fixture/$name.git" clone="$RUN_DIR/fixture/$name"
  mkdir -p "$seed"
  printf '# %s\n\nA verify-nico-agent fixture.\n' "$slug" > "$seed/README.md"
  fgit "$seed" init --quiet
  fgit "$seed" add README.md
  fgit "$seed" commit --quiet -m "fixture: initial"
  fgit "$RUN_DIR/fixture" clone --quiet --bare "$seed" "$bare"
  fgit "$RUN_DIR/fixture" clone --quiet "$bare" "$clone"
  fgit "$clone" remote set-url origin "https://github.com/$slug.git"
  rm -rf "$seed"
  printf '[url "file://%s"]\n\tinsteadOf = https://github.com/%s.git\n' "$bare" "$slug" >> "$FIXTURE_HOME/.gitconfig"
}

cmd_launch() {
  require_run_id
  local build=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-build) build=0 ;;
      *) die "launch: unknown argument $1" ;;
    esac
    shift
  done
  [ ! -e "$RUN_DIR" ] || die "$RUN_DIR already exists. Run cleanup first, or pick another VERIFY_RUN_ID"
  local tool
  for tool in cargo git jq curl node ss setsid; do
    command -v "$tool" >/dev/null || die "launch needs $tool on PATH"
  done

  if [ "$build" -eq 1 ]; then
    echo "launch: building nico-agent (cargo build --locked --bin nico-agent)" >&2
    (cd "$REPO_ROOT" && cargo build --locked --bin nico-agent >&2)
  fi
  local built="$REPO_ROOT/target/debug/nico-agent"
  [ -x "$built" ] || die "no build at $built (run without --no-build)"

  mkdir -p "$RUN_DIR"/{bin,fixture,bucket,worktrees,work,tmp,runtime} "$CONFIG_DIR"
  chmod 700 "$RUN_DIR/runtime"
  cp "$built" "$RUN_DIR/bin/nico-agent"
  write_stubs

  # The identity fixture commits are made with; any other github.com URL fails locally, not on the network.
  cat > "$FIXTURE_HOME/.gitconfig" <<EOF
[user]
	name = Verify Nico
	email = verify-nico@example.com
[init]
	defaultBranch = main
[url "file://$RUN_DIR/no-network/"]
	insteadOf = https://github.com/
	insteadOf = git@github.com:
EOF
  make_clone "$SLUG"
  make_clone "$SECOND"

  local port; port="$(free_port)"
  cat > "$CONFIG_DIR/config.toml" <<EOF
# verify-nico-agent: this run's scratch config. serve answers on a free port, keeps the
# Bucket in the run dir, and ticks once at launch: after that only refresh ticks. The
# morning agent is off, so the hour a run happens at never changes what a tick does.
port = $port
tick_minutes = 600

[bucket]
path = "$RUN_DIR/bucket"

[morning]
enabled = false
EOF

  cat > "$RUN_ENV" <<EOF
NICO_AGENT_BIN=$RUN_DIR/bin/nico-agent
NICO_AGENT_VERSION=$(cargo_version)
BUILD_SHA=$(git -C "$REPO_ROOT" rev-parse HEAD)
BUILD_DIRTY=$( [ -z "$(git -C "$REPO_ROOT" status --porcelain --untracked-files=no)" ] && echo no || echo yes)
PORT=$port
URL=http://127.0.0.1:$port
VERIFY_HOME=$FIXTURE_HOME
CONFIG_DIR=$CONFIG_DIR
BUCKET=$RUN_DIR/bucket
FIXTURE_SLUG=$SLUG
FIXTURE_CLONE=$RUN_DIR/fixture/${SLUG#*/}
SECOND_SLUG=$SECOND
SECOND_CLONE=$RUN_DIR/fixture/${SECOND#*/}
OUTSIDE_LOG=$RUN_DIR/outside.log
EOF
  start_serve "$port"
  echo "launch: run dir   $RUN_DIR"
  echo "launch: HOME      $FIXTURE_HOME (config $CONFIG_DIR/config.toml)"
  echo "launch: serve     pid $SERVE_PID on http://127.0.0.1:$port"
  echo "launch: fixtures  $SLUG at $RUN_DIR/fixture/${SLUG#*/}, $SECOND at $RUN_DIR/fixture/${SECOND#*/}"
  echo "launch: ready when doctor passes: control-nico-agent doctor"
}

# Start serve on <port> in the scratch HOME, wait till it answers, and record its pid in run.env
# as SERVE_PID, which must own the port.
start_serve() {
  local port="$1"
  # setsid: serve leads its own session, so it outlives this shell and cleanup can stop it whole.
  in_fixture "$RUN_DIR/work" setsid "$RUN_DIR/bin/nico-agent" serve \
    > "$RUN_DIR/serve.log" 2>&1 < /dev/null &
  local started=$!
  local i
  for i in $(seq 1 100); do
    kill -0 "$started" 2>/dev/null || die "serve exited at launch; see $RUN_DIR/serve.log (run cleanup)"
    if grep -q "could not listen" "$RUN_DIR/serve.log"; then
      die "serve could not listen on $port (taken meanwhile?); see $RUN_DIR/serve.log (run cleanup, launch again)"
    fi
    curl -fsS -o /dev/null "http://127.0.0.1:$port/api/status" 2>/dev/null && break
    sleep 0.1
  done
  curl -fsS -o /dev/null "http://127.0.0.1:$port/api/status" || die "serve did not answer on $port in 10s; see $RUN_DIR/serve.log"
  # The pid that owns the port, which must be this run's binary: the one doctor checks.
  local pid; pid="$(ss -ltnpH "sport = :$port" | sed -n 's/.*pid=\([0-9]*\),.*/\1/p' | head -1)"
  [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$RUN_DIR/bin/nico-agent" ] \
    || die "port $port is answered by pid ${pid:-?}, not this run's serve (run cleanup, launch again)"
  sed -i '/^SERVE_PID=/d' "$RUN_ENV"
  echo "SERVE_PID=$pid" >> "$RUN_ENV"
  SERVE_PID=$pid
}

# Stop this run's serve, its whole session, and start it again on the same HOME and port: what it
# shows after comes from the scratch config dir alone, as after a reboot or a service restart.
cmd_restart() {
  load_run
  local was="$SERVE_PID" i
  kill -TERM -- "-$was" 2>/dev/null || die "restart: serve (pid $was) is not running (run cleanup, launch again)"
  for i in $(seq 1 50); do
    kill -0 "$was" 2>/dev/null || break
    sleep 0.1
  done
  kill -KILL -- "-$was" 2>/dev/null || true
  start_serve "$PORT"
  echo "restart: serve pid $was stopped; pid $SERVE_PID on $URL"
}

cmd_doctor() {
  load_run
  local ok=1
  check() { # check <label> <command...>
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then echo "ok    $label"; else echo "FAIL  $label"; ok=0; fi
  }
  local version expected
  expected="$(cargo_version)"
  version="$(in_fixture "$RUN_DIR/work" "$NICO_AGENT_BIN" --version --json 2>/dev/null | jq -r .version 2>/dev/null || true)"
  check "nico-agent --version is $expected (Cargo.toml); got '${version:-<nothing>}'" test "$version" = "$expected"
  check "the launched binary is the current build (target/debug/nico-agent; relaunch after a rebuild)" \
    cmp -s "$NICO_AGENT_BIN" "$REPO_ROOT/target/debug/nico-agent"
  check "serve (pid $SERVE_PID) is alive and runs this run's binary" \
    test "$(readlink "/proc/$SERVE_PID/exe" 2>/dev/null)" = "$NICO_AGENT_BIN"
  check "port $PORT is serve's (pid $SERVE_PID), not another process's" \
    bash -c "ss -ltnpH 'sport = :$PORT' | grep -q 'pid=$SERVE_PID,'"
  check "GET $URL/api/status answers 200 with JSON" bash -c "curl -fsS '$URL/api/status' | jq -e .repos"
  check "scratch HOME is isolated: $FIXTURE_HOME is not $REAL_HOME" test "$FIXTURE_HOME" != "$REAL_HOME"
  check "scratch HOME is under the run dir" test "${FIXTURE_HOME#"$RUN_DIR"/}" != "$FIXTURE_HOME"
  check "config.toml sets port $PORT and the Bucket under the run dir" \
    bash -c "grep -qx 'port = $PORT' '$CONFIG_DIR/config.toml' && grep -qx 'path = \"$BUCKET\"' '$CONFIG_DIR/config.toml'"
  local name
  for name in gh ghbot herdr notify-send curl opencode2; do
    check "$name resolves to this run's stub" \
      test "$(in_fixture "$RUN_DIR/work" bash -c "command -v $name")" = "$RUN_DIR/stubs/$name"
  done
  check "$FIXTURE_SLUG's clone has origin https://github.com/$FIXTURE_SLUG.git, fetched from the run dir" \
    bash -c "[ \"\$(cd '$FIXTURE_CLONE' && git config remote.origin.url)\" = https://github.com/$FIXTURE_SLUG.git ]"
  check "$FIXTURE_SLUG's origin answers locally (git ls-remote)" fgit "$FIXTURE_CLONE" ls-remote origin HEAD
  echo "info  build $BUILD_SHA (uncommitted changes at launch: $BUILD_DIRTY)"
  echo "info  Repos: $(jq -r '[.repos[].slug] | join(" ") | if . == "" then "none yet" else . end' <<<"$(curl -fsS "$URL/api/status" 2>/dev/null || echo '{"repos":[]}')")"
  echo "info  outside calls so far: $(wc -l < "$OUTSIDE_LOG") (in $OUTSIDE_LOG)"
  [ "$ok" -eq 1 ] || die "doctor failed: do not drive this run"
}

# Write a JSON state file of the config dir as nico-agent writes them: pretty, newline-ended.
write_state() { # write_state <file> <json>
  mkdir -p "$(dirname -- "$1")"
  jq . <<<"$2" > "$1.tmp" && mv "$1.tmp" "$1"
}

cmd_seed() {
  load_run
  local what="${1:-}"; shift || true
  case "$what" in
    issues) seed_issues "$@" ;;
    dispatch) seed_dispatch "$@" ;;
    run) seed_run "$@" ;;
    morning) seed_morning "$@" ;;
    answer) seed_answer "$@" ;;
    correction) seed_correction "$@" ;;
    pace) seed_pace "$@" ;;
    assign) seed_assign "$@" ;;
    herdr) seed_herdr "$@" ;;
    dialog) seed_dialog "$@" ;;
    reviewer) seed_reviewer "$@" ;;
    wiki) seed_wiki "$@" ;;
    *) die "seed: usage: seed issues [second] | seed dispatch <n> pr|asking|stacked|restarted | seed run quality-scan|morning|faux-nico <n> | seed morning <file>|none | seed answer <file>|none [<part>] | seed correction <file>|none | seed pace <seconds>|none | seed assign answers|none | seed herdr <agent>|none | seed dialog <n>|none | seed reviewer <n>|none | seed wiki <wiki.json> <clone>" ;;
  esac
}

# What a read of verify/fixture's GitHub issues would cache, read now: one Ready, one Research
# (assigned to the user), one Stackable on an open PR, and three that are not Ready, each for its own reason. With
# `second`, verify/second's instead: #1 waiting on verify/fixture#1, a Blocker in another Repo,
# #2 on verify/outside#7, in no Repo, and #3 on verify/fixture#20, closed as it is read.
seed_issues() {
  [ "${1:-}" != second ] || { seed_second_issues; return; }
  local at; at="$(now)"
  local u="https://github.com/$SLUG/issues"
  write_state "$CONFIG_DIR/issues/$SLUG.json" "$(jq -n --arg at "$at" --arg u "$u" --arg s "$SLUG" '
    def issue($n; $title; $labels): {
      key: "\($s)#\($n)", title: $title, url: "\($u)/\($n)", branch: "agent/fixture-\($n)",
      created_at: "2026-01-0\($n)T09:00:00Z", open: true, labels: $labels, assignees: [],
      has_sub_issues: false, blockers: [] };
    { read_at: $at, user: ["verify-nico"], issues: [
      issue(1; "Verify: a Ready issue"; ["ready-for-agent"]),
      issue(2; "Verify: not labelled"; []),
      (issue(3; "Verify: waits on #1"; ["ready-for-agent"])
        | .blockers = [{key: "\($s)#1", title: "Verify: a Ready issue", resolved: false, prs: []}]),
      (issue(4; "Verify: assigned to someone else"; ["ready-for-agent"]) | .assignees = ["someone-else"]),
      (issue(5; "Verify: a Research issue"; ["ready-for-agent", "research"]) | .assignees = ["verify-nico"]),
      (issue(6; "Verify: stacks on #9 PR"; ["ready-for-agent"])
        | .blockers = [{key: "\($s)#9", title: "Verify: a Blocker in review", resolved: false,
            prs: [{number: 109, url: "https://github.com/\($s)/pull/109", head_branch: "agent/fixture-9"}]}])
    ] }')"
  jq -c '{ file: input_filename, read_at, issues: [.issues[] | {key, title}] }' "$CONFIG_DIR/issues/$SLUG.json"
}

seed_second_issues() {
  local at; at="$(now)"
  write_state "$CONFIG_DIR/issues/$SECOND.json" "$(jq -n --arg at "$at" --arg s "$SECOND" --arg f "$SLUG" '
    def waits($n; $title; $blocker; $blocker_title): {
      key: "\($s)#\($n)", title: $title, url: "https://github.com/\($s)/issues/\($n)",
      branch: "agent/second-\($n)", created_at: "2026-01-0\($n)T10:00:00Z", open: true,
      labels: ["ready-for-agent"], assignees: [], has_sub_issues: false,
      blockers: [{key: $blocker, title: $blocker_title, resolved: false, prs: []}] };
    { read_at: $at, user: ["verify-nico"], issues: [
      waits(1; "Verify: waits on fixture #1"; "\($f)#1"; "Verify: a Ready issue"),
      waits(2; "Verify: waits on an outside issue"; "verify/outside#7"; "Verify: an outside Blocker"),
      (waits(3; "Verify: waits on fixture #20 installed"; "\($f)#20"; "Verify: a closed Blocker")
        | .blockers[0] += {resolved: true, closed_at: $at})
    ] }')"
  jq -c '{ file: input_filename, read_at, issues: [.issues[] | {key, title}] }' "$CONFIG_DIR/issues/$SECOND.json"
}

# A Dispatch of verify/fixture#<n> with every step done, as the loop records one, in a worktree of
# the fixture on agent/fixture-<n> holding .evidence/<n>/proof.txt. `pr`: its draft PR #(100+n) open
# on the worktree's head, as GitHub last said. `asking`: no PR, its Implementer Asking. `stacked`:
# as `pr`, but Stacked on #9's open PR #109 (head agent/fixture-9), its Base and its PR's base.
# `restarted`: as `pr`, its Implementer restarted by the loop for two failing Verdicts an hour ago,
# as herdr lets the loop do (here herdr is a stub, and every restart fails at its tab).
seed_dispatch() {
  local n="${1:-}" kind="${2:-}"
  [[ "$n" =~ ^[0-9]+$ ]] && [[ "$kind" =~ ^(pr|asking|stacked|restarted)$ ]] || die "seed: usage: seed dispatch <n> pr|asking|stacked|restarted"
  local issue="$SLUG#$n" branch="agent/fixture-$n" worktree="$RUN_DIR/worktrees/fixture-$n"
  [ ! -e "$worktree" ] || die "seed: verify/fixture#$n is already seeded at $worktree"
  if [ -f "$CONFIG_DIR/dispatches.json" ] && jq -e --arg i "$issue" 'any(.[]; .issue == $i and .closed_at == null)' "$CONFIG_DIR/dispatches.json" >/dev/null; then
    die "seed: $issue already has a live Dispatch"
  fi
  fgit "$FIXTURE_CLONE" worktree add --quiet -b "$branch" "$worktree" origin/main
  printf 'work on %s\n' "$issue" > "$worktree/work-$n.txt"
  fgit "$worktree" add "work-$n.txt"
  fgit "$worktree" commit --quiet -m "work on $issue"
  local head; head="$(fgit "$worktree" rev-parse HEAD)"
  mkdir -p "$worktree/.evidence/$n"
  printf 'Evidence of %s at %s, seeded by verify-nico-agent\n' "$issue" "$head" > "$worktree/.evidence/$n/proof.txt"

  local at pr=null asking=null base=main stacked_on=null restarts="[]"; at="$(now)"
  if [ "$kind" = restarted ]; then
    restarts="$(jq -nc --arg at "$(date -u -d '-1 hour' +%Y-%m-%dT%H:%M:%SZ)" '[range(2) | { at: $at, reason: "verdict", by: "loop" }]')"
  fi
  local url="https://github.com/$SLUG/pull/$((100 + n))" below="https://github.com/$SLUG/pull/109"
  if [ "$kind" = stacked ]; then
    base=agent/fixture-9
    stacked_on="$(jq -nc --arg u "$below" '{ number: 109, url: $u, head_branch: "agent/fixture-9" }')"
  fi
  if [ "$kind" != asking ]; then
    pr="\"$url\""
    local prs="{}"
    [ -f "$CONFIG_DIR/prs.json" ] && prs="$(cat "$CONFIG_DIR/prs.json")"
    write_state "$CONFIG_DIR/prs.json" "$(jq --arg url "$url" --arg s "$SLUG" --argjson num $((100 + n)) \
      --arg head "$head" --arg at "$at" --arg base "$base" --arg below "$below" --arg kind "$kind" '
      def open($num; $head; $base): { repo: $s, number: $num, state: "open", draft: true,
        head_sha: $head, base: $base, mergeable: "mergeable", updated_at: $at, final: false,
        checked_at: $at, merged_at: null };
      .[$url] = open($num; $head; $base)
      | if $kind == "stacked" then .[$below] = open(109; "seeded-109"; "main") else . end' <<<"$prs")"
  else
    asking="$(jq -nc --arg at "$at" '{ since: $at, question: "Should the fixture keep its README? (seeded by verify-nico-agent)" }')"
  fi
  local all="[]"
  [ -f "$CONFIG_DIR/dispatches.json" ] && all="$(cat "$CONFIG_DIR/dispatches.json")"
  write_state "$CONFIG_DIR/dispatches.json" "$(jq --arg issue "$issue" --arg n "$n" --arg s "$SLUG" \
    --arg clone "$FIXTURE_CLONE" --arg branch "$branch" --arg worktree "$worktree" --arg at "$at" \
    --argjson pr "$pr" --argjson asking "$asking" --arg base "$base" --argjson stacked_on "$stacked_on" \
    --argjson restarts "$restarts" '. + [{
      issue: $issue, title: "Verify: seeded Dispatch \($n)", url: "https://github.com/\($s)/issues/\($n)",
      repo: $s, repo_path: $clone, branch: $branch, base: $base, worktree: $worktree,
      workspace: "verify-workspace-\($n)", pr: $pr,
      implementer: { agent: "impl-fixture-\($n)", harness: "claude", model: null, effort: null,
        tab: "verify-tab-\($n)", pane: "verify-pane-\($n)" },
      reviewer: null, research: false, asking: $asking,
      completed: ["claim", "fetch", "worktree", "tab", "agent start", "agent ready", "prompt"],
      failure: null, claimed: true, warnings: [], restarts: $restarts,
      created_at: $at, updated_at: $at, closed_at: null }
      + if $stacked_on == null then {} else { stacked_on: $stacked_on } end]' <<<"$all")"
  jq -n --arg issue "$issue" --arg worktree "$worktree" --arg branch "$branch" --arg head "$head" \
    --argjson pr "$pr" --arg evidence "$worktree/.evidence/$n/proof.txt" --arg kind "$kind" \
    '{ issue: $issue, kind: $kind, worktree: $worktree, branch: $branch, head: $head, pr: $pr, evidence: $evidence }'
}

# A Run open and blocked since now, as the loop records one once herdr reports its agent blocked:
# the `quality-scan` of verify/fixture, the `morning` agent, or the `faux-nico <n>` of the Asking of
# a Dispatch seeded `asking`.
# What the morning agent leaves in the config dir: <file>'s text as morning.md, or none.
seed_morning() {
  case "${1:-}" in
    none) rm -f "$CONFIG_DIR/morning.md" ;;
    "") die "seed: usage: seed morning <file>|none" ;;
    *) [ -f "$1" ] || die "seed: no file $1"; cp "$1" "$CONFIG_DIR/morning.md" ;;
  esac
}

# A Repo's Wiki built elsewhere, as the Bucket keeps one: <wiki.json> (a real Wiki, its target a
# GitHub Repo) committed to this run's Bucket at wiki/<owner>/<name>/wiki.json, as a build's last
# act does, and a clone of that Repo made on disk from <clone> under fixture/, its origin the GitHub
# URL, holding the Wiki's commit, for `repo add`. Prints { repo, clone, commit }. The Bucket must
# exist: `repo add` a Repo first.
seed_wiki() {
  local usage="seed: usage: seed wiki <wiki.json> <clone>"
  local file="${1:-}" from="${2:-}"
  [ -f "$file" ] && [ -d "$from" ] || die "$usage"
  local repo commit
  repo="$(jq -r '.target.repo // empty' "$file")"; commit="$(jq -r '.commit // empty' "$file")"
  [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && [ -n "$commit" ] || die "seed: $file is not a Wiki of a Repo"
  jq -e '.target.tag == null' "$file" >/dev/null || die "seed: $file is a Library version's Wiki; only a Repo's is seeded"
  git -C "$BUCKET" rev-parse --git-dir >/dev/null 2>&1 || die "seed: no Bucket yet; repo add a Repo first"
  local clone="$RUN_DIR/fixture/${repo#*/}"
  if [ ! -d "$clone" ]; then
    git clone --quiet "$from" "$clone" || die "seed: could not clone $from"
    git -C "$clone" remote set-url origin "https://github.com/$repo.git"
  fi
  git -C "$clone" cat-file -e "$commit^{commit}" 2>/dev/null || die "seed: $from does not hold the Wiki's commit $commit"
  mkdir -p "$BUCKET/wiki/$repo"
  cp "$file" "$BUCKET/wiki/$repo/wiki.json"
  git -C "$BUCKET" add "wiki/$repo/wiki.json"
  HOME="$FIXTURE_HOME" git -C "$BUCKET" commit --quiet -m "wiki $repo $commit" || die "seed: could not commit the Wiki to the Bucket"
  jq -nc --arg r "$repo" --arg c "$clone" --arg s "$commit" '{ repo: $r, clone: $c, commit: $s }'
}

# What the wiki model answers each headless call from now on: <file>'s text, or with none, each
# call fails as opencode2 with no model does. With <part>, a trail as the prompt names it
# (`verify/fixture > Docs`), only the calls about that part; none takes every answer away,
# corrections too.
seed_answer() {
  local answers="$RUN_DIR/opencode-answers"
  case "${1:-}" in
    none) rm -rf "$RUN_DIR/opencode-answer" "$answers" "$RUN_DIR/opencode-correction" ;;
    "") die "seed: usage: seed answer <file>|none [<part>]" ;;
    *)
      [ -f "$1" ] || die "seed: no file $1"
      if [ -z "${2:-}" ]; then cp "$1" "$RUN_DIR/opencode-answer"; return; fi
      mkdir -p "$answers"
      cp "$1" "$answers/$(printf '%s' "$2" | md5sum | cut -c 1-32)" ;;
  esac
}

# What the wiki model answers each correction (a call with -s) from now on: <file>'s text, or
# with none, the answer for its part again.
seed_correction() {
  case "${1:-}" in
    none) rm -f "$RUN_DIR/opencode-correction" ;;
    "") die "seed: usage: seed correction <file>|none" ;;
    *) [ -f "$1" ] || die "seed: no file $1"; cp "$1" "$RUN_DIR/opencode-correction" ;;
  esac
}

# How long the wiki model takes over each call from now on, before it answers (or fails), so a
# build lasts long enough to watch; with none, it answers at once again.
seed_pace() {
  case "${1:-}" in
    none) rm -f "$RUN_DIR/opencode-pace" ;;
    *[!0-9]*|"") die "seed: usage: seed pace <seconds>|none" ;;
    *) printf '%s\n' "$1" > "$RUN_DIR/opencode-pace" ;;
  esac
}

# Whether the gh stub answers an assign to the user, `gh issue edit <n> --repo <slug> --add-assignee
# @me`, from now on, as GitHub does once signed in; with none, it fails as every gh call does.
seed_assign() {
  case "${1:-}" in
    answers) : > "$RUN_DIR/gh-assign" ;;
    none) rm -f "$RUN_DIR/gh-assign" ;;
    *) die "seed: usage: seed assign answers|none" ;;
  esac
}

# The one agent of the real herdr the run reaches from now on, an Implementer the user started
# there, and herdr's list of agents, the real one; with none, herdr is all a stub again.
seed_herdr() {
  case "${1:-}" in
    none) rm -f "$RUN_DIR/herdr-agent" ;;
    ""|-*) die "seed: usage: seed herdr <agent>|none" ;;
    *) printf '%s\n' "$1" > "$RUN_DIR/herdr-agent" ;;
  esac
}

# herdr answering the start of rev-fixture-<n>, the Reviewer of a Dispatch seeded `pr`, from now on:
# its tab, its start and its prompt, then listing it working beside its Implementer, idle; with none,
# herdr is all a stub again. Not with `seed herdr`, whose list of agents is the real herdr's.
seed_reviewer() {
  case "${1:-}" in
    none) rm -f "$RUN_DIR/herdr-reviewer" "$RUN_DIR/herdr-reviewer-started" ;;
    ""|-*|*[!0-9]*) die "seed: usage: seed reviewer <n>|none" ;;
    *) printf '%s\n' "$1" > "$RUN_DIR/herdr-reviewer" ;;
  esac
}

# A real Claude (Haiku) in a herdr tab of its own, in the run's dialog/ folder, named as the
# Implementer of a Dispatch seeded `asking` (impl-fixture-<n>), its folder trusted, Asking two
# questions in a choice dialog; the run reaches it through `seed herdr`. Needs herdr and claude.
# With none, its tab is closed and herdr is all a stub again; cleanup closes it too.
DIALOG_PROMPT="Call the AskUserQuestion tool right now, before anything else, with exactly two questions. Question 1, header 'Node tint': 'Should map nodes carry a tint of their Stage hue?' with options 'Faint tint' (a wash of the Stage's hue) and 'No tint' (keep the fill white). Question 2, header 'Sections': 'Should the panel's sections start folded?' with options 'Folded' (one line each until opened) and 'Open' (every section shown whole). Do nothing else: no files, no commands. After I answer, reply with one short sentence."
seed_dialog() {
  local n="${1:-}" usage="seed: usage: seed dialog <n>|none"
  if [ "$n" = none ]; then close_dialog; seed_herdr none; return; fi
  [[ "$n" =~ ^[0-9]+$ ]] || die "$usage"
  command -v herdr >/dev/null && command -v claude >/dev/null || die "seed: dialog needs herdr and claude on PATH"
  [ ! -f "$RUN_DIR/dialog-tab" ] || die "seed: a dialog is open already; seed dialog none first"
  local agent="impl-fixture-$n" dir="$RUN_DIR/dialog" tab
  mkdir -p "$dir"
  tab="$(herdr tab create ${HERDR_WORKSPACE_ID:+--workspace "$HERDR_WORKSPACE_ID"} --cwd "$dir" --label "verify-$VERIFY_RUN_ID-dialog" --no-focus)"
  jq -r .result.tab.tab_id <<<"$tab" > "$RUN_DIR/dialog-tab"
  # Its startup stops on the trust question for a new folder, which herdr calls not ready.
  herdr agent start "$agent" --kind claude --pane "$(jq -r .result.root_pane.pane_id <<<"$tab")" -- --model haiku >/dev/null 2>&1 || true
  herdr agent read "$agent" --source visible | grep -q "trust this folder" || die "seed: $agent did not ask to trust $dir"
  herdr agent send-keys "$agent" down enter >/dev/null
  # A prompt sent while it still loads stalls: send it again.
  local try
  for try in 1 2 3 4 5; do
    sleep 2
    herdr agent prompt "$agent" "$DIALOG_PROMPT" --wait --until working --timeout 30000 >/dev/null 2>&1 && break
    [ "$try" -lt 5 ] || die "seed: $agent did not take its prompt"
  done
  herdr agent wait "$agent" --until blocked --timeout 120000 >/dev/null || die "seed: $agent did not ask"
  seed_herdr "$agent"
  echo "seed: $agent Asking in herdr tab $(cat "$RUN_DIR/dialog-tab")"
}

close_dialog() {
  [ -f "$RUN_DIR/dialog-tab" ] || return 0
  herdr tab close "$(cat "$RUN_DIR/dialog-tab")" >/dev/null 2>&1 || true
  rm -f "$RUN_DIR/dialog-tab"
}

seed_run() {
  local trigger="${1:-}" n="${2:-}" run
  local usage="seed: usage: seed run quality-scan|morning|faux-nico <n>"
  case "$trigger" in
    quality-scan) run="$(jq -nc --arg s "$SLUG" '{ trigger: "quality-scan", repo: $s, agent: "quality-scan-fixture" }')" ;;
    morning) run='{ "trigger": "morning", "repo": null, "agent": "morning" }' ;;
    faux-nico)
      [[ "$n" =~ ^[0-9]+$ ]] || die "$usage"
      local since=""
      [ -f "$CONFIG_DIR/dispatches.json" ] && since="$(jq -r --arg i "$SLUG#$n" \
        'first(.[] | select(.issue == $i and .closed_at == null) | .asking.since // empty)' "$CONFIG_DIR/dispatches.json")"
      [ -n "$since" ] || die "seed: $SLUG#$n is not Asking (seed dispatch $n asking first)"
      run="$(jq -nc --arg s "$SLUG" --arg n "$n" --arg since "$since" \
        '{ trigger: "faux-nico", issue: "\($s)#\($n)", asking: $since, repo: $s, agent: "faux-nico-fixture-\($n)" }')" ;;
    *) die "$usage" ;;
  esac
  local at all="[]"; at="$(now)"
  [ -f "$CONFIG_DIR/runs.json" ] && all="$(cat "$CONFIG_DIR/runs.json")"
  jq -e --arg a "$(jq -r .agent <<<"$run")" 'any(.[]; .agent == $a and .closed_at == null)' <<<"$all" >/dev/null \
    && die "seed: $(jq -r .agent <<<"$run") already has an open Run"
  run="$(jq -c --arg at "$at" '. + { at: $at, harness: "claude", model: null, effort: null, tab: null,
    pane: null, workspace: "verify-workspace-\(.agent)", worktree: null, blocked_since: $at, closed_at: null }' <<<"$run")"
  write_state "$CONFIG_DIR/runs.json" "$(jq --argjson run "$run" '. + [$run]' <<<"$all")"
  printf '%s\n' "$run"
}

cmd_drift() {
  load_run
  local kind="${1:-}"
  case "$kind" in
    # A push to the seeded PR: a new commit in its worktree, and GitHub saying so in prs.json.
    push)
      local n="${2:-}"; [[ "$n" =~ ^[0-9]+$ ]] || die "drift: usage: drift push <n>"
      local worktree="$RUN_DIR/worktrees/fixture-$n" url="https://github.com/$SLUG/pull/$((100 + n))"
      [ -d "$worktree" ] && jq -e --arg u "$url" 'has($u)' "$CONFIG_DIR/prs.json" >/dev/null 2>&1 \
        || die "drift: no seeded PR for $SLUG#$n (seed dispatch $n pr first)"
      local old; old="$(jq -r --arg u "$url" '.[$u].head_sha' "$CONFIG_DIR/prs.json")"
      printf 'more work\n' >> "$worktree/work-$n.txt"
      fgit "$worktree" commit --quiet --all -m "more work on $SLUG#$n"
      local head; head="$(fgit "$worktree" rev-parse HEAD)"
      write_state "$CONFIG_DIR/prs.json" "$(jq --arg u "$url" --arg h "$head" --arg at "$(now)" \
        '.[$u].head_sha = $h | .[$u].updated_at = $at | .[$u].checked_at = $at' "$CONFIG_DIR/prs.json")"
      jq -n --arg pr "$url" --arg old "$old" --arg head "$head" '{ pr: $pr, old: $old, head: $head }'
      ;;
    # The cached read older than a tick: the next status or dispatch asks the Source again.
    stale)
      local file="$CONFIG_DIR/issues/$SLUG.json"
      [ -f "$file" ] || die "drift: no cached read of $SLUG (seed issues first)"
      write_state "$file" "$(jq '.read_at = "2000-01-01T00:00:00Z"' "$file")"
      jq -c '{ read_at }' "$file"
      ;;
    # GitHub rate-limited for an hour, as a 429 would leave it.
    pause)
      local until; until="$(date -u -d '+60 minutes' +%Y-%m-%dT%H:%M:%SZ)"
      local pauses="{}"
      [ -f "$CONFIG_DIR/pauses.json" ] && pauses="$(cat "$CONFIG_DIR/pauses.json")"
      write_state "$CONFIG_DIR/pauses.json" "$(jq --arg u "$until" '.github = $u' <<<"$pauses")"
      jq -c . "$CONFIG_DIR/pauses.json"
      ;;
    # The PR a seeded Stacked dispatch sits on, #109, merged or closed unmerged, as GitHub would say.
    below)
      local how="${2:-}" url="https://github.com/$SLUG/pull/109"
      [[ "$how" =~ ^(merged|closed)$ ]] || die "drift: usage: drift below merged|closed"
      jq -e --arg u "$url" 'has($u)' "$CONFIG_DIR/prs.json" >/dev/null 2>&1 \
        || die "drift: no PR below seeded (seed dispatch <n> stacked first)"
      write_state "$CONFIG_DIR/prs.json" "$(jq --arg u "$url" --arg how "$how" --arg at "$(now)" '
        .[$u] |= (.state = $how | .final = true | .updated_at = $at | .checked_at = $at
          | .merged_at = (if $how == "merged" then $at else null end))' "$CONFIG_DIR/prs.json")"
      jq -c --arg u "$url" '.[$u] | { url: $u, state, final, merged_at }' "$CONFIG_DIR/prs.json"
      ;;
    # A merge into verify/fixture's Base on GitHub, rewriting README.md (or the file named, made
    # if new), then fetched into the clone as the loop's next fetch would: origin/main moves on
    # past what a Wiki describes.
    base)
      local work="$RUN_DIR/fixture/fixture-drift" file="${2:-README.md}" old head
      [[ "$file" != /* && "$file" != *..* ]] || die "drift: usage: drift base [<file in the fixture>]"
      old="$(fgit "$FIXTURE_CLONE" rev-parse origin/main)"
      rm -rf "$work"
      fgit "$RUN_DIR/fixture" clone --quiet "$RUN_DIR/fixture/fixture.git" "$work"
      mkdir -p "$(dirname "$work/$file")"
      printf '# %s, moved on\n\nThe Base moved past the Wiki.\n' "$SLUG" > "$work/$file"
      fgit "$work" add -- "$file"
      fgit "$work" commit --quiet -m "fixture: the Base moves on"
      fgit "$work" push --quiet origin HEAD:main
      rm -rf "$work"
      fgit "$FIXTURE_CLONE" fetch --quiet origin
      head="$(fgit "$FIXTURE_CLONE" rev-parse origin/main)"
      jq -n --arg old "$old" --arg head "$head" --arg file "$file" '{ base: "main", file: $file, old: $old, head: $head }'
      ;;
    # A tag pushed to verify/second on GitHub, as a Library's release: a commit off its main,
    # which stays where it was, adding lib/greet.sh and lib/README.md under the subfolder lib/.
    tag)
      local tag="${2:-}" work="$RUN_DIR/fixture/second-tag" commit
      [ -n "$tag" ] || die "drift: usage: drift tag <tag>"
      rm -rf "$work"
      fgit "$RUN_DIR/fixture" clone --quiet "$RUN_DIR/fixture/${SECOND#*/}.git" "$work"
      mkdir -p "$work/lib"
      printf '#!/bin/sh\n# Greets whoever is named, %s.\ngreet() {\n  echo "hello, $1"\n}\n' "$tag" > "$work/lib/greet.sh"
      printf '# lib\n\nThe greeting library, %s.\n' "$tag" > "$work/lib/README.md"
      fgit "$work" add lib
      fgit "$work" commit --quiet -m "fixture: release $tag"
      fgit "$work" tag "$tag"
      fgit "$work" push --quiet origin "refs/tags/$tag"
      commit="$(fgit "$work" rev-parse HEAD)"
      rm -rf "$work"
      jq -n --arg slug "$SECOND" --arg tag "$tag" --arg commit "$commit" '{ repo: $slug, tag: $tag, commit: $commit }'
      ;;
    *) die "drift: usage: drift push <n> | drift stale | drift pause | drift below merged|closed | drift base [<file>] | drift tag <tag>" ;;
  esac
}

cmd_state() {
  load_run
  echo "# config dir: $CONFIG_DIR"
  echo "## files (sha256; locks, temp files and the Library clones' insides left out)"
  (cd "$CONFIG_DIR" && find . -path ./libraries -prune -o -type f ! -name '*.lock' ! -name '*.tmp' -print | sort | xargs -r sha256sum)
  echo "## Library clones: each one's tags and worktrees"
  local clone
  for clone in "$CONFIG_DIR"/libraries/*/*.git; do
    [ -d "$clone" ] || continue
    echo "${clone#"$CONFIG_DIR"/}: tags $(git -C "$clone" tag | sort | tr '\n' ' ')"
    git -C "$clone" worktree list
  done
  echo "## config.toml"
  cat "$CONFIG_DIR/config.toml"
  echo "## dispatches.json (issue, steps done, failure, pr, asking, closed)"
  if [ -f "$CONFIG_DIR/dispatches.json" ]; then
    jq -c '.[] | { issue, completed: (.completed | length), failure, pr, asking: (.asking != null), closed_at }' "$CONFIG_DIR/dispatches.json"
  fi
  echo "## verdicts"
  if [ -d "$CONFIG_DIR/verdicts" ]; then
    (cd "$CONFIG_DIR/verdicts" && find . -name '*.json' | sort | while read -r f; do echo "$f $(jq -c '{result, sha}' "$f")"; done)
  fi
  echo "## wikis.json (each Wiki's last build)"
  [ ! -f "$CONFIG_DIR/wikis.json" ] || jq -c 'to_entries[] | { wiki: .key } + .value' "$CONFIG_DIR/wikis.json"
  echo "## Bucket: git log --stat"
  if [ -d "$BUCKET/.git" ]; then
    fgit "$BUCKET" log --format='%s' --stat
  else
    echo "(no Bucket yet)"
  fi
  echo "## outside calls (stubs)"
  cat "$OUTSIDE_LOG"
}

# record <prefix> <cmd text> <stdout file> <stderr file> <exit code>
record() {
  mkdir -p "$(dirname -- "$1")"
  printf '%s\n' "$2" > "$1.cmd"
  # cat, not cp: mktemp files are 0600 and cp would carry that onto the evidence.
  cat "$3" > "$1.stdout"
  cat "$4" > "$1.stderr"
  printf '%s\n' "$5" > "$1.exit"
}

cmd_run() {
  load_run
  local evidence=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --evidence) shift; evidence="${1:-}"; [ -n "$evidence" ] || die "run: --evidence needs a path prefix" ;;
      --) shift; break ;;
      *) break ;;
    esac
    shift
  done
  [ $# -gt 0 ] || die "run: usage: run [--evidence PREFIX] -- <nico-agent args...>"
  local out err code=0
  out="$(mktemp)"; err="$(mktemp)"
  in_fixture "$RUN_DIR/work" "$NICO_AGENT_BIN" "$@" >"$out" 2>"$err" || code=$?
  if [ -n "$evidence" ]; then
    record "$evidence" "$(printf 'nico-agent'; printf ' %q' "$@")" "$out" "$err" "$code"
  fi
  cat "$out"
  cat "$err" >&2
  rm -f "$out" "$err"
  exit "$code"
}

cmd_http() {
  load_run
  local evidence="" sent=""
  # --header, as another site's page or a name rebound to 127.0.0.1 would send it; `Host:` sends none.
  local -a extra=()
  while [ "${1:-}" = --evidence ] || [ "${1:-}" = --header ]; do
    case "$1" in
      --evidence) evidence="${2:-}"; shift 2 || die "http: --evidence needs a path prefix" ;;
      --header) extra+=(-H "${2:-}"); sent+="[${2:-}] "; shift 2 || die "http: --header needs 'NAME: VALUE'" ;;
    esac
  done
  local method="${1:-}" path="${2:-}" body="${3:-}"
  [ -n "$method" ] && [ -n "$path" ] || die "http: usage: http [--evidence PREFIX] [--header 'NAME: VALUE']... <METHOD> <PATH> [BODY]"
  local out err headers status code=0
  out="$(mktemp)"; err="$(mktemp)"; headers="$(mktemp)"
  # --path-as-is: the path goes as given, `..` included, as a hand-made request would send it.
  local -a args=(-sS --path-as-is -X "$method" -D "$headers" -o "$out" -w '%{http_code}' "${extra[@]}")
  [ -n "$body" ] && args+=(--data-raw "$body")
  status="$(curl "${args[@]}" "$URL$path" 2>"$err")" || code=$?
  [ "$code" -eq 0 ] || die "http: could not reach serve at $URL: $(cat "$err")"
  if [ -n "$evidence" ]; then
    local cmd="$sent$method $path${body:+ $body}"
    record "$evidence" "$cmd" "$out" "$err" "$status"
    tr -d '\r' < "$headers" > "$evidence.headers"
  fi
  cat "$out"; echo
  echo "HTTP $status" >&2
  rm -f "$out" "$err" "$headers"
  [ "$status" -lt 400 ]
}

cmd_page() {
  load_run
  local url="$URL"
  if [ "${1:-}" = --tunnel ]; then
    url="${TUNNEL_URL:-}"; shift
    [ -n "$url" ] || die "page: no tunnel stand-in in this run. Run: control-nico-agent tunnel start"
  fi
  local pw; pw="$(playwright_dir)" || die "page: no playwright package found beside the playwright CLI; set VERIFY_PLAYWRIGHT=<dir of the playwright package>"
  # The real node, not a version manager's shim, which may not work under the browser's HOME.
  local node_bin; node_bin="$(node -p process.execPath)"
  mkdir -p "$RUN_DIR/browser-home"
  # The browser is the user's, not the app's, but it too keeps its profile, caches and temp files in the run.
  env -i PATH="$PATH" HOME="$RUN_DIR/browser-home" TMPDIR="$RUN_DIR/tmp" LANG=C.UTF-8 \
    XDG_CONFIG_HOME="$RUN_DIR/browser-home/.config" XDG_CACHE_HOME="$RUN_DIR/browser-home/.cache" \
    PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$REAL_HOME/.cache/ms-playwright}" \
    VERIFY_PLAYWRIGHT="$pw" \
    VERIFY_CHROMIUM="${VERIFY_CHROMIUM:-$(command -v chromium || command -v chromium-browser || command -v google-chrome || true)}" \
    "$node_bin" "$SKILL_DIR/page.mjs" "$url" "$@"
}

# tunnel.mjs between the page and serve, as cloudflared and Access are: it cuts a response idle for
# 100 seconds and, switched, answers every request with a 502 or Access's login redirect.
cmd_tunnel() {
  load_run
  local what="${1:-}"
  case "$what" in
    start)
      [ -z "${TUNNEL_URL:-}" ] || die "tunnel: already started at $TUNNEL_URL"
      local port; port="$(free_port)"
      # As setup-tunnel.sh does for cloudflared: serve answers the tunnel's host once bucket.url names it.
      sed -i "/^\[bucket\]$/a url = \"http://127.0.0.1:$port\"" "$CONFIG_DIR/config.toml"
      setsid "$(node -p process.execPath)" "$SKILL_DIR/tunnel.mjs" "$URL" "$port" "$RUN_DIR/tunnel.log" \
        > "$RUN_DIR/tunnel.out" 2>&1 < /dev/null &
      local i
      for i in $(seq 1 50); do
        curl -fsS -o /dev/null "http://127.0.0.1:$port/api/status" 2>/dev/null && break
        sleep 0.1
      done
      curl -fsS -o /dev/null "http://127.0.0.1:$port/api/status" || die "tunnel: did not answer on $port in 5s; see $RUN_DIR/tunnel.out"
      printf 'TUNNEL_URL=http://127.0.0.1:%s\nTUNNEL_LOG=%s\n' "$port" "$RUN_DIR/tunnel.log" >> "$RUN_ENV"
      echo "tunnel: http://127.0.0.1:$port to serve at $URL, logging to $RUN_DIR/tunnel.log"
      ;;
    pass|502|signed-out)
      [ -n "${TUNNEL_URL:-}" ] || die "tunnel: not started. Run: control-nico-agent tunnel start"
      curl -fsS -X PUT --data-raw "$what" "$TUNNEL_URL/__tunnel/mode"
      ;;
    *) die "tunnel: usage: tunnel start|pass|502|signed-out" ;;
  esac
}

# Stop what this run started, never by name: each process whose executable lives in the run dir
# (serve, and any CLI run still going), each browser `page` left with its profile in the run's
# tmp, and the tunnel stand-in logging into the run dir. serve leads its own session (setsid), so
# its whole group goes with it, git children included.
stop_run() {
  local p pid exe stopped=() alive=()
  for p in /proc/[0-9]*; do
    pid="${p#/proc/}"
    exe="$(readlink "$p/exe" 2>/dev/null || true)"
    if [ "${exe#"$RUN_DIR"/}" != "$exe" ]; then
      if [ "$(ps -o pgid= -p "$pid" | tr -d ' ')" = "$pid" ]; then
        kill -TERM -- "-$pid" 2>/dev/null || true
      else
        kill -TERM "$pid" 2>/dev/null || true
      fi
      stopped+=("$pid")
    elif { tr '\0' ' ' < "$p/cmdline"; } 2>/dev/null | grep -qF -e "--user-data-dir=$RUN_DIR/tmp/" -e "$RUN_DIR/tunnel.log"; then
      kill -TERM "$pid" 2>/dev/null || true
      stopped+=("$pid")
    fi
  done
  [ ${#stopped[@]} -gt 0 ] || return 0
  local i
  for i in $(seq 1 50); do
    alive=()
    for pid in "${stopped[@]}"; do kill -0 "$pid" 2>/dev/null && alive+=("$pid"); done
    [ ${#alive[@]} -eq 0 ] && break
    sleep 0.1
  done
  for pid in "${alive[@]}"; do kill -KILL "$pid" 2>/dev/null || true; done
  echo "cleanup: stopped pid ${stopped[*]} (this run's serve, CLI runs, browsers or tunnel stand-in)"
}

cmd_cleanup() {
  require_run_id
  if [ ! -d "$RUN_DIR" ]; then
    echo "cleanup: nothing at $RUN_DIR"
    return 0
  fi
  case "$RUN_DIR" in
    "$RUN_ROOT"/*) ;;
    *) die "cleanup: refusing to remove $RUN_DIR (outside $RUN_ROOT)" ;;
  esac
  # shellcheck disable=SC1090
  [ -f "$RUN_ENV" ] && . "$RUN_ENV"
  close_dialog
  stop_run
  chmod -R u+rwX "$RUN_DIR" 2>/dev/null || true
  rm -rf "$RUN_DIR"
  rmdir "$RUN_ROOT" 2>/dev/null || true
  echo "cleanup: removed $RUN_DIR (evidence under .evidence/ is untouched)"
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    launch) cmd_launch "$@" ;;
    restart) cmd_restart "$@" ;;
    doctor) cmd_doctor "$@" ;;
    env) load_run; echo "$RUN_ENV" ;;
    seed) cmd_seed "$@" ;;
    drift) cmd_drift "$@" ;;
    state) cmd_state "$@" ;;
    run) cmd_run "$@" ;;
    http) cmd_http "$@" ;;
    page) cmd_page "$@" ;;
    tunnel) cmd_tunnel "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    ""|-h|--help|help) sed -n '2,/^set -euo pipefail$/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//' ;;
    *) die "unknown subcommand '$sub' (launch|restart|doctor|env|seed|drift|state|run|http|page|tunnel|cleanup)" ;;
  esac
}

main "$@"
